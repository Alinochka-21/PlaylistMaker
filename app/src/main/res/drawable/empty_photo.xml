<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:solid="http://schemas.android.com/aapt">
    <item
        android:gravity="center"
        android:width="312dp"
        android:height="312dp"
        >

        <shape
            android:shape="rectangle">
            <solid android:color="?attr/colorPrimary" />
            <stroke
                android:width="1dp"
                android:color="@color/YP_Text_Gray"
                android:dashWidth="30dp"
                android:dashGap="15dp"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_add_photo_100"
        android:width="80dp"
        android:height="80dp"
        android:gravity="center"
        />

</layer-list>