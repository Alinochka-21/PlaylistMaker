<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageButton
        android:id="@+id/backButtonInPlaylist"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="?attr/colorPrimary"
        android:src="@drawable/ic_arrow_back_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorSecondary"
        app:tintMode="src_in" />

    <TextView
        android:id="@+id/newPlaylist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginStart="12dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/ys_display_medium"
        android:text="@string/new_playlist"

        android:textColor="?attr/colorSecondary"
        android:textFontWeight="500"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/backButtonInPlaylist"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/albumCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"

        android:layout_marginTop="30dp"
        android:scaleType="centerCrop"

        android:src="@drawable/empty_photo"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/backButtonInPlaylist"
        app:shapeAppearanceOverlay="@style/RoundedImageInPlaylistTable" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/playlistNameStroke"
        style="@style/MyOutlinedBox"

        android:layout_width="match_parent"
        android:layout_height="56dp"

        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="32dp"

        android:hint="@string/playlistName"
        app:hintTextColor="@color/For_Edit_Text"

        app:boxCornerRadiusBottomEnd="3.5dp"
        app:boxCornerRadiusBottomStart="3.5dp"
        app:boxCornerRadiusTopEnd="3.5dp"
        app:boxCornerRadiusTopStart="3.5dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/albumCover">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/playlistName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="text"
            style="@style/editTextStyle"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/playlistDescriptionStroke"
        style="@style/MyOutlinedBox"

        android:layout_width="match_parent"
        android:layout_height="56dp"

        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"

        android:hint="@string/description"
        app:hintTextColor="@color/For_Edit_Text"

        app:boxCornerRadiusBottomEnd="3.5dp"
        app:boxCornerRadiusBottomStart="3.5dp"
        app:boxCornerRadiusTopEnd="3.5dp"
        app:boxCornerRadiusTopStart="3.5dp"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playlistNameStroke">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/playlistDescription"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="text"
            style="@style/editTextStyle"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/createPlaylist"
        android:layout_width="match_parent"
        android:layout_height="44dp"

        android:layout_marginHorizontal="17dp"
        android:layout_marginBottom="32dp"

        android:background="@drawable/create_playlist_button"
        android:enabled="false"
        android:fontFamily="@font/ys_display_medium"
        android:letterSpacing="0"
        android:text="@string/create"

        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="@color/YP_White"
        android:textFontWeight="500"
        android:textSize="16sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>