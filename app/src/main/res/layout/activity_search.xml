<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:id="@+id/search_activity"
    android:layout_marginHorizontal="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:layout_marginStart="-12dp"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:id="@+id/back"
            style="@style/Widget.MaterialComponents.Button.TextButton"

            app:icon="@drawable/ic_arrow_back_24"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorSecondary"
            app:iconSize="@dimen/iconSize"
            android:backgroundTint="?attr/colorPrimary"
            android:contentDescription="@string/arrow"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/search"
            android:textSize="@dimen/textSize"
            android:textColor="?attr/colorSecondary"
            android:fontFamily="@font/ys_display_medium"
            android:textFontWeight="400"
            android:layout_marginTop="16dp"
            />
    </LinearLayout>

    <FrameLayout
        style="@style/FrameLayoutStyleInSettings"
        android:layout_marginHorizontal="4dp">

    <EditText
        android:id="@+id/editText"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:hint="@string/search"
        android:textColorHint="?attr/colorOnSecondary"
        android:textSize="16sp"
        android:textColor="@color/YP_Black"
        android:fontFamily="@font/ys_display_regular"
        android:textFontWeight="500"
        android:lines="1"
        android:background="@drawable/search_background"
        android:paddingStart="12dp"
        android:paddingEnd="40dp"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_magnifier_16"
        android:imeOptions="actionDone"
        android:singleLine="true"
        />

        <ImageView
            android:id="@+id/clearIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/ic_clear_16"
            android:visibility="gone"
            />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTrackView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:visibility="invisible"
        />
        
    <ProgressBar
        android:id="@+id/progressBarInSearchActivity"
        android:layout_marginTop="140dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/YP_Blue_Progress_Bar"
        android:visibility="gone"
        />

   <LinearLayout
       android:id="@+id/placeholderLayoutNotFound"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:paddingTop="102dp"
       android:visibility="gone">

   <ImageView
       style="@style/placeholderImgNotFound"
       android:id="@+id/placeholderNotFoundImg"
       />

   <TextView
       style="@style/placeholderText"
       android:id="@+id/placeholderNotFoundText"
       android:text="@string/not_found"
       />
   </LinearLayout>

   <LinearLayout
       android:id="@+id/placeholderNotInternet"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:paddingTop="102dp"
       android:visibility="gone">

   <ImageView
       style="@style/placeholderImgNotInternet"
       android:id="@+id/placeholderImgNotInternet"
       />

   <TextView
       style="@style/placeholderText"
       android:id="@+id/placeholderNoInternetText"
       android:text="@string/not_internet"
       />

   <com.google.android.material.button.MaterialButton
        android:id="@+id/placeholderErrorButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="?attr/colorSecondary"
        app:cornerRadius="54dp"
        android:text="@string/update"
        android:textSize="14sp"
        android:textColor="?attr/colorPrimary"
        android:fontFamily="@font/ys_display_medium"
        android:textFontWeight="500"
        android:textAllCaps="false"
        app:elevation="0dp"
       />
   </LinearLayout>

   <LinearLayout
       android:id="@+id/trackHistory"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_gravity="center_horizontal"
       android:orientation="vertical"
       android:visibility="invisible"
       android:layout_marginTop="50dp">

       <TextView
           android:id="@+id/textYouFound"
           style="@style/placeholderText"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="@string/you_found"
           android:layout_marginHorizontal="4dp"
           android:textFontWeight="500"
           android:layout_marginBottom="20dp"
           />
       
       <androidx.recyclerview.widget.RecyclerView
           android:id="@+id/recyclerviewTrackHistory"
           android:layout_width="match_parent"
           android:layout_height="0dp"
           android:layout_weight="1"
           app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
           />

       <com.google.android.material.button.MaterialButton
           android:id="@+id/bottomClearTrackHistory"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_marginTop="24dp"
           android:layout_gravity="center_horizontal"
           android:text="@string/clear_history"
           android:textColor="?attr/colorPrimary"
           android:textSize="14sp"
           android:letterSpacing="0"
           android:textFontWeight="500"
           android:fontFamily="@font/ys_display_medium"
           android:textAllCaps="false"
           android:backgroundTint="?attr/colorSecondary"
           app:cornerRadius="54dp"
           app:elevation="0dp"
           />
   </LinearLayout>
   </FrameLayout>
</LinearLayout>