<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="?attr/colorPrimary">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/playlistCoverPlace"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/ic_default_45"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay = "@style/RoundedImageInPlaylistList">
    </com.google.android.material.imageview.ShapeableImageView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/playlistNamePlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="1dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/ys_display_regular"
            android:textFontWeight="400"
            android:textSize="16sp"
            android:textColor="?attr/colorSecondary"
            tools:text="Playlist Name">
        </TextView>

            <TextView
                android:id="@+id/playlistSizePlace"
                style="@style/TextViewInTrackOrPlaylistExample"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="666 tracks">
            </TextView>
    </LinearLayout>
</LinearLayout>