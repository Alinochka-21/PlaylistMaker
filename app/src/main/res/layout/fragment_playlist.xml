<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/YP_Light_Gray"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/coverInPlaylistFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:scaleType="center"
            tools:src="@drawable/ic_empty_cover_236"
            />
        <ImageButton
            android:id="@+id/backFromPlaylistFragmentButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/ic_arrow_back_24"
            android:background="@android:color/transparent"
            app:tint="@color/YP_Black" />

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/coverInPlaylistFragment"
            android:layout_marginTop="24dp"
            android:textColor="@color/YP_Black"
            android:textSize="24sp"
            android:textFontWeight="700"
            android:fontFamily="@font/ys_display_bold"
            tools:text="Name"
            android:maxLines="1"
            android:letterSpacing="0"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/description"
            style="@style/textPlaylistFragment"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/name"

            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            tools:text="description"/>

        <LinearLayout
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/description"

            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"

            android:orientation="horizontal">

            <TextView
                android:id="@+id/time"
                style="@style/textPlaylistFragment"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"

                tools:text="500 минут"
                />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_point_13"
                app:tint="@color/YP_Black"
                android:layout_marginVertical="4dp"
                />

            <TextView
                android:id="@+id/tracksCount"
                style="@style/textPlaylistFragment"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text= "98 треков"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/icons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/info"

            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp">

            <ImageView
                android:id="@+id/share"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_share_app_24"
                app:tint="@color/YP_Black"
                />

            <ImageView
                android:id="@+id/menu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_points_24"
                app:tint ="@color/YP_Black"
                />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/bottomSheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
            app:behavior_hideable="false"
            android:background="@drawable/bottom_sheet_shape"
            >

            <View
                android:layout_width="50dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/handle"/>

            <TextView
                android:id="@+id/noTracks"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/ys_display_regular"
                android:textFontWeight="400"
                android:textSize="16sp"
                android:textColor="?attr/colorSecondary"
                android:text="@string/no_tracks"
                android:layout_marginTop="50dp"
                />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playlistListRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="13dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>

    <View android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <LinearLayout
        android:id="@+id/menuBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:behavior_hideable="true"
        app:behavior_peekHeight="350dp"
        android:background="@drawable/bottom_sheet_shape"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        tools:visibility="invisible">

        <View
            android:id="@+id/hand"
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/handle"
            android:layout_marginBottom="20dp"
            />

        <LinearLayout
            android:id="@+id/element"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="13dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/menuBSCover"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_default_45"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay = "@style/RoundedImageInPlaylistList">
            </com.google.android.material.imageview.ShapeableImageView>

            <LinearLayout
                android:id="@+id/elementInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/menuBSName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="1dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/ys_display_regular"
                    android:textFontWeight="400"
                    android:textSize="16sp"
                    android:textColor="?attr/colorSecondary"
                    tools:text="Playlist Name">
                </TextView>

                <TextView
                    android:id="@+id/menuBSSize"
                    style="@style/TextViewInTrackOrPlaylistExample"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="666 tracks">
                </TextView>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playlistShare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ys_display_regular"
                android:textFontWeight="400"
                android:textSize="16sp"
                android:textColor="?attr/colorSecondary"
                android:text="@string/share"
                android:layout_marginTop="16dp"
                android:paddingTop="21dp"
                android:letterSpacing="0"/>

            <TextView
                android:id="@+id/editPlaylist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:fontFamily="@font/ys_display_regular"
                android:textFontWeight="400"
                android:textColor="?attr/colorSecondary"
                android:text="@string/edit"
                android:paddingTop="42dp"
                android:letterSpacing="0"/>

            <TextView
                android:id="@+id/deletePlaylist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:fontFamily="@font/ys_display_regular"
                android:textFontWeight="400"
                android:textColor="?attr/colorSecondary"
                android:text="@string/delete"
                android:paddingTop="42dp"
                android:letterSpacing="0"/>
        </LinearLayout>


    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>